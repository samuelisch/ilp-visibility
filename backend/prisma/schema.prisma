generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  cash_or_srs
  cpfis
}

enum Domicile {
  sgd
  usd
}

enum PremiumAllocationType {
  single
  recurring
  term
}

enum TermEndBehaviour {
  stop
  persist_last
}

enum ChargeSchedule {
  perpetual
  recurring
  term
  escalating_n
}

enum FeeType {
  account_value
  annual_premium
  cumulative_premium_paid
  notional_premium
  basic_sum_assured
}

enum SurrenderFeeType {
  account_value
  cumulative_premium_paid
}

model Policy {
  id                       Int                         @id @default(autoincrement())
  providerId               Int                         @map("provider_id")
  name                     String
  description              String
  sourceType               SourceType                  @map("source_type")
  domicile                 Domicile
  paymentTermYears         Int?                        @map("payment_term_years")
  provider                 Provider                    @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  policyAccountFees        PolicyAccountFee[]
  policyAccountSurrenderFees PolicyAccountSurrenderFee[]
  policyAccounts           PolicyAccount[]

  @@unique([providerId, name, domicile, description, sourceType], map: "policies_provider_name_domicile_source_unique")
  @@map("policies")
}

model PolicyAccountFeeTerm {
  id                 Int              @id @default(autoincrement())
  policyAccountFeeId Int              @map("policy_account_fee_id")
  policyYear         Int              @map("policy_year")
  chargePercentage   Decimal          @map("charge_percentage") @db.Decimal(5, 2)
  policyAccountFee   PolicyAccountFee @relation(fields: [policyAccountFeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([policyAccountFeeId, policyYear], map: "policy_account_fee_terms_unique")
  @@map("policy_account_fee_terms")
}

model PolicyAccountFee {
  id                      Int                    @id @default(autoincrement())
  policyId                Int                    @map("policy_id")
  policyAccountId         Int?                   @map("policy_account_id")
  description             String
  chargeSchedule          ChargeSchedule         @map("charge_schedule")
  activeFromPolicyYear    Int                    @map("active_from_policy_year")
  termEndBehaviour        TermEndBehaviour?      @map("term_end_behaviour")
  recurringLength         Int?                   @map("recurring_length")
  feeType                 FeeType                @map("fee_type")
  notionalPercentage      Decimal?               @map("notional_percentage") @db.Decimal(5, 2)
  isPercentageAvailable   Boolean                @default(true) @map("is_percentage_available")
  chargePercentage        Decimal?               @map("charge_percentage") @db.Decimal(5, 2)
  flatFeeAmount           Decimal?               @map("flat_fee_amount") @db.Decimal(10, 2)
  minPremium              Int?                   @map("min_premium")
  maxPremium              Int?                   @map("max_premium")
  policyAccountFeeTerms   PolicyAccountFeeTerm[]
  policyAccount           PolicyAccount?         @relation(fields: [policyAccountId, policyId], references: [id, policyId], onDelete: NoAction, onUpdate: NoAction, map: "policy_account_fees_account_policy_fkey")
  policy                  Policy                 @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("policy_account_fees")
}

model PolicyAccountPremiumAllocationTerm {
  id                      Int           @id @default(autoincrement())
  policyAccountId         Int           @map("policy_account_id")
  policyYear              Int           @map("policy_year")
  premiumChargePercentage Decimal       @map("premium_charge_percentage") @db.Decimal(5, 2)
  policyAccount           PolicyAccount @relation(fields: [policyAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([policyAccountId, policyYear], map: "policy_account_premium_allocation_terms_unique")
  @@map("policy_account_premium_allocation_terms")
}

model PolicyAccountSurrenderFeeTerm {
  id                          Int                       @id @default(autoincrement())
  policyAccountSurrenderFeeId Int                       @map("policy_account_surrender_fee_id")
  policyYear                  Int                       @map("policy_year")
  chargePercentage            Decimal                   @map("charge_percentage") @db.Decimal(5, 2)
  policyAccountSurrenderFee   PolicyAccountSurrenderFee @relation(fields: [policyAccountSurrenderFeeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "policy_account_surrender_fee__policy_account_surrender_fee_fkey")

  @@unique([policyAccountSurrenderFeeId, policyYear], map: "policy_account_surrender_fee_terms_unique")
  @@map("policy_account_surrender_fee_terms")
}

model PolicyAccountSurrenderFee {
  id                             Int                             @id(map: "policy_account_surrender_fee_pkey") @default(autoincrement())
  policyId                       Int                             @map("policy_id")
  policyAccountId                Int?                            @map("policy_account_id")
  termEndBehaviour               TermEndBehaviour                @map("term_end_behaviour")
  feeType                        SurrenderFeeType                @map("fee_type")
  policyAccountSurrenderFeeTerms PolicyAccountSurrenderFeeTerm[]
  policy                         Policy                          @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "policy_account_surrender_fee_policy_id_fkey")
  policyAccount                  PolicyAccount?                  @relation(fields: [policyAccountId, policyId], references: [id, policyId], onDelete: NoAction, onUpdate: NoAction, map: "policy_account_surrender_fees_policy_account_fk")

  @@map("policy_account_surrender_fees")
}

model PolicyAccount {
  id                                 Int                                    @id @default(autoincrement())
  policyId                           Int                                    @map("policy_id")
  description                        String
  allocationFromPolicyYear           Int                                    @map("allocation_from_policy_year")
  allocationTillPolicyYear           Int?                                   @map("allocation_till_policy_year")
  premiumChargePercentage            Decimal?                               @map("premium_charge_percentage") @db.Decimal(5, 2)
  premiumAllocationType              PremiumAllocationType                  @map("premium_allocation_type")
  termEndBehaviour                   TermEndBehaviour?                      @map("term_end_behaviour")
  policyAccountFees                  PolicyAccountFee[]
  policyAccountPremiumAllocationTerms PolicyAccountPremiumAllocationTerm[]
  policyAccountSurrenderFees         PolicyAccountSurrenderFee[]
  policy                             Policy                                 @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, policyId], map: "policy_policy_account_unique")
  @@map("policy_accounts")
}

model Provider {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  policies Policy[]

  @@map("providers")
}
